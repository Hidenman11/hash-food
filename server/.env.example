# PostgreSQL (docker-compose: postgres://postgres:postgres@localhost:5432/hashfood)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hashfood"

PORT=4000
NODE_ENV=development

# Strong secret in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated origins for Next.js + mobile web
CORS_ORIGIN="http://localhost:3000"

# Browser key (restrict by HTTP referrer in Google Cloud Console)
GOOGLE_MAPS_BROWSER_KEY=""
# Server key for Directions API proxy (/v1/maps/directions)
GOOGLE_MAPS_SERVER_KEY=""
GOOGLE_MAPS_MAP_ID=""

# mock | flutterwave | http
MOBILE_MONEY_PROVIDER="mock"
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
# Optional shared secret for /v1/payments/webhook/mobile-money (header x-webhook-secret)
MOBILE_MONEY_WEBHOOK_SECRET=""
# Custom gateway: JSON POST target for STK/push initiation
MOBILE_MONEY_HTTP_INIT_URL=""
